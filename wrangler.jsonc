{
  "name": "eta-site",
  "compatibility_date": "2026-10-01",
  // Worker script: only handles /api/click and /go/<code>; everything else is the
  // static site, served by the asset server exactly as before.
  "main": "worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/go/*"]
  },
  // Workers Logs off: we don't want request metadata (IPs, user agents) kept in logs.
  "observability": { "enabled": false },
  // Workers Analytics Engine dataset for aggregate click counts (free plan: 100k writes/day).
  "analytics_engine_datasets": [
    { "binding": "CLICKS", "dataset": "eta_clicks" }
  ]
}
